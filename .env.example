# ==============================================================================
#                 VIDEO AI PLATFORM - BACKEND (.ENV.EXAMPLE)
#                   Thư mục: be/.env.example (File mẫu cấu hình)
# ==============================================================================

PROJECT_NAME="Video AI Automation Platform"
ENV=development
DEBUG=True
HOST=127.0.0.1
PORT=8001

CORS_ORIGINS=["http://localhost:3000","http://localhost:3002","http://127.0.0.1:3000","http://127.0.0.1:3002"]

OMNIVOICE_MODEL_ID=k2-fsa/OmniVoice
OMNIVOICE_DEVICE=cuda:0
OMNIVOICE_DTYPE=float16
OMNIVOICE_DEFAULT_STEPS=32

HF_HOME=D:/DuAnCaNhan/video_ai/be/storage/hf_cache
HF_HUB_DISABLE_SYMLINKS_WARNING=1

AUDIO_SAMPLE_RATE=24000
MAX_AUDIO_SAMPLE_DURATION_SEC=12.0

DATABASE_URL="mongodb://localhost:27017/video_ai?authSource=admin"

CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
CLOUDINARY_URL="cloudinary://your_api_key:your_api_secret@your_cloud_name"

PYTHONPATH=be;be/app/core/engines


